{
  "info": {
    "name": "Note Management System",
    "description": "API collection for the Search Assignment including all CRUD, search, filter, sort, and paginate endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Notes",
      "item": [
        {
          "name": "1. Create Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Note\",\n  \"content\": \"This is the content of my first note\",\n  \"category\": \"work\",\n  \"isPinned\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notes" ]
            }
          }
        },
        {
          "name": "2. Create Bulk Notes",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"title\": \"Bulk Note 1\",\n    \"content\": \"Content for bulk note 1\",\n    \"category\": \"personal\"\n  },\n  {\n    \"title\": \"Bulk Note 2\",\n    \"content\": \"Content for bulk note 2\",\n    \"category\": \"others\"\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes/bulk",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notes", "bulk" ]
            }
          }
        },
        {
          "name": "3. Get All Notes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notes" ]
            }
          }
        },
        {
          "name": "4. Get Note by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notes/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notes", ":id" ],
              "variable": [
                { "key": "id", "value": "replace_with_actual_id" }
              ]
            }
          }
        },
        {
          "name": "5. Replace Note",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Replaced Note\",\n  \"content\": \"This note has been completely replaced.\",\n  \"category\": \"work\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notes", ":id" ],
              "variable": [
                { "key": "id", "value": "replace_with_actual_id" }
              ]
            }
          }
        },
        {
          "name": "6. Partial Update Note",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPinned\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notes", ":id" ],
              "variable": [
                { "key": "id", "value": "replace_with_actual_id" }
              ]
            }
          }
        },
        {
          "name": "7. Delete Single Note",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notes/:id",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notes", ":id" ],
              "variable": [
                { "key": "id", "value": "replace_with_actual_id" }
              ]
            }
          }
        },
        {
          "name": "8. Delete Bulk Notes",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"replace_with_actual_id_1\",\n    \"replace_with_actual_id_2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes/bulk",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notes", "bulk" ]
            }
          }
        },
        {
